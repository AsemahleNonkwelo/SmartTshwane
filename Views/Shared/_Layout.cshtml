<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>SmartTshwane</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header><nav><a class="brand" asp-controller="Home" asp-action="Index">◉ SmartTshwane</a><div><a asp-controller="Home" asp-action="Index">Home</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Requests" asp-action="Index">My Reports</a><a asp-controller="Requests" asp-action="Create">Report an Issue</a><a asp-controller="Notifications" asp-action="Index">Notifications</a>@if(User.IsInRole("Admin")){<a asp-controller="Admin" asp-action="Index">Admin</a><a asp-controller="Admin" asp-action="Manage">Manage</a>}<form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button class="link">Logout</button></form>}else{<a asp-controller="Account" asp-action="Login">Login</a><a asp-controller="Account" asp-action="Register">Register</a>}</div></nav></header><main class="container">@if(TempData["Message"]!=null){<div class="success">@TempData["Message"]</div>}@RenderBody()</main><footer>SmartTshwane · Student demonstration project · Not an official municipal service</footer></body></html>