@using SmartTshwane.Models
<h1>Municipal administration</h1><div class="card"><h2>Departments</h2><form method="post" asp-action="AddDepartment"><label>Department name</label><input name="name" required maxlength="100"/><button class="button">Add department</button></form>@foreach(Department d in ViewBag.Departments){<p>@d.Name</p>}</div>
<div class="card"><h2>Categories and department assignment</h2><form method="post" asp-action="AddCategory"><label>New category</label><input name="name" required maxlength="100"/><label>Department</label><select name="departmentId"><option value="">Unassigned</option>@foreach(Department d in ViewBag.Departments){<option value="@d.Id">@d.Name</option>}</select><button class="button">Add category</button></form>@foreach(Category c in ViewBag.Categories){<form method="post" asp-action="AssignCategory"><input type="hidden" name="id" value="@c.Id"/><label>@c.Name</label><select name="departmentId"><option value="">Unassigned</option>@foreach(Department d in ViewBag.Departments){if(c.DepartmentId==d.Id){<option value="@d.Id" selected>@d.Name</option>}else{<option value="@d.Id">@d.Name</option>}}</select><button class="button">Save</button></form>}</div>
<div class="card"><h2>Users and roles</h2>@foreach(User u in ViewBag.Users){<form method="post" asp-action="ChangeRole"><input type="hidden" name="id" value="@u.Id"/><label>@u.FullName (@u.Email)</label><select name="role">@if(u.Role=="Admin"){<option selected>Admin</option><option>Citizen</option>}else{<option>Admin</option><option selected>Citizen</option>}</select><button class="button">Update role</button></form>}</div>
