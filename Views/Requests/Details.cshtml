@model ServiceRequest
<div class="card"><h1>Report #TSH-@Model.Id</h1><span class="status">@Model.Status</span><h2>@Model.Title</h2><p>@Model.Description</p><p><strong>Category:</strong> @Model.Category?.Name</p><p><strong>Location:</strong> @Model.Location</p>@if(Model.Latitude.HasValue){<p><strong>GPS:</strong> @Model.Latitude, @Model.Longitude</p>}<p><strong>Submitted:</strong> @Model.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</p>@if(!string.IsNullOrWhiteSpace(Model.AdminNote)){<p><strong>Admin update:</strong> @Model.AdminNote</p>}<a asp-action="Index">← My reports</a></div>