@model ServiceRequest
<div class="card"><h1>Report a municipal issue</h1><p>Describe the issue clearly so it can be tracked.</p><form method="post"><div asp-validation-summary="All" class="error"></div><label asp-for="CategoryId">Service category</label><select asp-for="CategoryId" asp-items="ViewBag.Categories"><option value="">Select a category</option></select><label asp-for="Title"></label><input asp-for="Title" maxlength="120"/><label asp-for="Description"></label><textarea asp-for="Description" rows="5" maxlength="2000"></textarea><label asp-for="Location">Street or area</label><input asp-for="Location" maxlength="200"/><label asp-for="Latitude">Latitude (optional)</label><input asp-for="Latitude" type="number" step="any"/><label asp-for="Longitude">Longitude (optional)</label><input asp-for="Longitude" type="number" step="any"/><button class="button">Submit report</button></form></div>